[Unit]
Description=OmniTest hardware acquisition agent (host sidecar)
Documentation=file:///opt/demo-hub/demo-platform-core/data/sources/omnitest/hardware/agent/README.md
# 依赖 NI-PAL 的 nipal 服务：它负责在启动时创建 /dev/nipalk，缺了它 NI-VISA 初始化会失败。
After=network.target nipal.service
Wants=network.target

[Service]
Type=simple
User=fjs
Group=fjs
# 串口 /dev/ttyUSB0 属 root:dialout，必须补组才能打开。
SupplementaryGroups=dialout
WorkingDirectory=/opt/demo-hub/demo-platform-core/data/sources/omnitest

# ── 运行时配置（全部走环境变量，代码里不写死任何路径/密钥）──
Environment=HWA_BIND=172.21.0.1
Environment=HWA_PORT=8790
Environment=HWA_PYTHON=/home/fjs/miniconda3/envs/agent_env/bin/python
Environment=HWA_SCRIPT_ROOT=/opt/demo-hub/demo-platform-core/data/sources/omnitest/hardware
Environment=HWA_STATE_DIR=/home/fjs/.omnitest-agent
# NI-VISA 运行时：护照目录与库路径（缺一不可，否则 @ivi 打不开）
Environment=LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/ni-visa
Environment=PYVISA_LIBRARY=/usr/lib/x86_64-linux-gnu/libvisa.so.21.0.0
Environment=PYTHONUNBUFFERED=1
# 访问令牌：安装时由部署脚本替换，不得提交进仓库
Environment=HWA_TOKEN=__TOKEN__

ExecStart=/home/fjs/miniconda3/envs/agent_env/bin/python /opt/demo-hub/demo-platform-core/data/sources/omnitest/hardware/agent/omnitest_hw_agent.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
# 注意：不要开 PrivateTmp。NI-PAL 会写 /tmp/nipalk-load.log，隔离后排查线索会丢。

[Install]
WantedBy=multi-user.target
